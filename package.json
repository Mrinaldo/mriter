{
  "name": "mriter",
  "version": "1.1.0",
  "description": "Distraction-free desktop manuscript writing and book publishing studio for novelists and authors",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mrinaldo/mriter.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:store": "npm run build && electron-builder --win appx",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64",
    "dist:mac:universal": "npm run build && electron-builder --mac --universal",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always",
    "release:win": "npm run build && electron-builder --win --publish always",
    "release:mac": "npm run build && electron-builder --mac --publish always"
  },
  "keywords": [
    "novel",
    "writing",
    "manuscript",
    "epub",
    "publishing",
    "author",
    "electron"
  ],
  "author": "Mriter Authors",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "docx": "^9.15.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.7.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.63.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.mriter.studio",
    "productName": "Mriter",
    "compression": "maximum",
    "afterPack": "./build/afterPack.cjs",
    "publish": {
      "provider": "github",
      "owner": "Mrinaldo",
      "repo": "mriter"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "differentialPackage": true,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Mriter",
      "deleteAppDataOnUninstall": false
    },
    "appx": {
      "identityName": "62897MrinaldoInc.Mriter",
      "publisher": "CN=542E7A83-E5F6-41F7-BFB1-740FAE6388C0",
      "publisherDisplayName": "Mrinaldo Inc.",
      "applicationId": "Mriter",
      "displayName": "Mriter",
      "backgroundColor": "#1E1E1E",
      "languages": [
        "en-US"
      ],
      "capabilities": [
        "runFullTrust"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "minimumSystemVersion": "10.15.0"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "public/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
